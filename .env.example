# Copy to .env for local work. Nothing here is committed with a value.
# Neon Postgres, the direct connection string (not the pooler); the goodhart schema is created by the
# migrations.
DATABASE_URL=
GOODHART_DB_SCHEMA=goodhart
# A long random string: client addresses are stored only as a salted hash.
GOODHART_SALT=
# The parity key: the parity check uses it for its own budget. The same value as the Actions secret.
GOODHART_PARITY_KEY=
# The site origin the API accepts, comma separated.
GOODHART_CORS_ORIGINS=https://mekala27-45.github.io
# Where the views files go; any writable folder.
GOODHART_VIEWS=/tmp/goodhart-views
